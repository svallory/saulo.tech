{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saulo-tech",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "assets": {
    "directory": "dist/public",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "saulo.tech", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
