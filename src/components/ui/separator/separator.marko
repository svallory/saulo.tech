import { cn } from "../../../lib/utils.ts";
static const styles = {
  root: "shrink-0 bg-border data-horizontal:h-px data-horizontal:w-full data-vertical:w-px data-vertical:self-stretch",
} as const;

export interface Input extends Marko.Input<"div"> {
  orientation?: "horizontal" | "vertical";
  decorative?: boolean;
}

<const/{ orientation = "horizontal", decorative = true, class: className, content, ...rest }=input/>

<div
  data-slot="separator"
  data-orientation=orientation
  role=(decorative ? "none" : "separator")
  aria-orientation=(decorative ? undefined : orientation)
  class=cn(styles.root, className)
  ...rest
>
  <${content}/>
</div>
